# Copy to .env.prod on the server (it is git-ignored) and fill in.
#   chmod 600 .env.prod

# The public hostname. Its DNS record must already point at this server, or
# Caddy cannot obtain a certificate. Use "localhost" for a test on your own machine.
DOMAIN=

# Database password. Letters and digits only, since it is placed inside a URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Only change these for a local test where ports 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
