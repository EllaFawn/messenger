# Copy to .env and edit. .env is git-ignored - never commit real values.
# `npm run start` and `npm run migrate` in packages/server read .env automatically.

# Required to run the server. At least 20 characters. Generate with: openssl rand -base64 24
INVITE_CODE=

# Optional. Defaults shown. The database default matches docker-compose.yml (local development only).
DATABASE_URL=postgres://messager:messager@127.0.0.1:5432/messager
HOST=127.0.0.1
PORT=3000
